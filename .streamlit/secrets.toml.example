# Template only. Do NOT put real values in this file or commit real secrets.
# On Streamlit Community Cloud, paste your real values into
# "Advanced settings" -> "Secrets" when you deploy (or later under App settings).

GROQ_API_KEY = "your-groq-api-key"
GROQ_MODEL = "your-groq-model-name"
# Optional:
# GOOGLE_API_KEY = "your-google-api-key"

# Free Postgres (e.g. from Neon). Keep the quotes. This is what makes
# accounts and check-ins survive app restarts on Streamlit Cloud.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
